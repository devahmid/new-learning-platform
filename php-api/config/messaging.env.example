# Configuration Email pour Hébergement Mutualisé
# Copiez ce fichier vers .env et adaptez les valeurs

# Configuration SMTP (selon votre hébergeur)
SMTP_HOST=localhost
SMTP_PORT=587
SMTP_USERNAME=votre_email@votre-domaine.com
SMTP_PASSWORD=votre_mot_de_passe_email

# Configuration de l'expéditeur
FROM_EMAIL=noreply@votre-domaine.com
FROM_NAME="Plateforme Éducative"

# URL de la plateforme
PLATFORM_URL=https://votre-domaine.com

# Configuration de la base de données
DB_HOST=localhost
DB_NAME=votre_base_de_donnees
DB_USER=votre_utilisateur_db
DB_PASS=votre_mot_de_passe_db

# Configuration des notifications
EMAIL_NOTIFICATIONS_ENABLED=true
IN_APP_NOTIFICATIONS_ENABLED=true

# Limites de messagerie
MAX_MESSAGE_LENGTH=5000
MAX_ATTACHMENT_SIZE=10485760
MAX_ATTACHMENTS_PER_MESSAGE=5

# Configuration des templates
DEFAULT_TEMPLATE_LANGUAGE=fr
TEMPLATE_CACHE_ENABLED=true

# Configuration de sécurité
MESSAGE_ENCRYPTION_ENABLED=false
ATTACHMENT_VIRUS_SCAN_ENABLED=false

# Configuration des rappels
PAYMENT_REMINDER_DAYS=7
PROGRESS_NOTIFICATION_FREQUENCY=daily
